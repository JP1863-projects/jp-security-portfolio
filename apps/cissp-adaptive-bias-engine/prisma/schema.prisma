// CISSP Adaptive Bias Engine
// Prisma ORM v7 + PostgreSQL. DATABASE_URL is configured in prisma.config.ts.
// Original practice material only; this application is not affiliated with ISC2.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

enum CisspDomain {
  SECURITY_RISK_MANAGEMENT
  ASSET_SECURITY
  SECURITY_ARCHITECTURE_ENGINEERING
  COMMUNICATION_NETWORK_SECURITY
  IDENTITY_ACCESS_MANAGEMENT
  SECURITY_ASSESSMENT_TESTING
  SECURITY_OPERATIONS
  SOFTWARE_DEVELOPMENT_SECURITY
}

enum QuestionType {
  BEST
  MOST
  FIRST
  NEXT
  PRIMARY
  LEAST
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum DeploymentEnvironment {
  CLOUD
  ON_PREM
  HYBRID
  GENERAL
}

enum QuizMode {
  PRACTICE_25
  PRACTICE_50
  PRACTICE_100
  CAT_SIMULATION_125
  CUSTOM
}

enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum QuestionAttemptStatus {
  DELIVERED
  ANSWERED
  TIMED_OUT
}

enum BiasPattern {
  PATCH_FIRST
  TOOL_FIRST
  SECURITY_BEFORE_BUSINESS
  OPERATIONS_BEFORE_GOVERNANCE
  CONTROL_BEFORE_REQUIREMENTS
  ENGINEER_OWNS_RISK
  ENGINEER_OWNS_DATA
  TECHNICAL_PERFECTION
  TECHNOLOGY_SOLVES_EVERYTHING
  SECURITY_OVER_AVAILABILITY
  SECURITY_OVER_BUSINESS
}

enum BiasSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

// Auth.js / NextAuth Prisma adapter models.
model User {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String?
  email                 String?               @unique
  emailVerified         DateTime?
  image                 String?
  role                  UserRole              @default(STUDENT)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  accounts              Account[]
  sessions              Session[]
  authoredQuizzes       Quiz[]                @relation("QuizAuthor")
  quizAttempts          QuizAttempt[]
  questionAttempts      QuestionAttempt[]
  biasEvents            BiasEvent[]
  biasScores            BiasScore[]
  readinessSnapshots    ReadinessSnapshot[]
  studyRecommendations  StudyRecommendation[]
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Question.options JSON shape (validated by Zod at the API boundary):
// [{"id":"A","text":"...","whyAppealing":"...",
//   "whyRejected":"...","biasPatterns":["PATCH_FIRST"]}]
// Correct answers and explanations MUST NOT be sent before answering.
model Question {
  id                       String                @id @default(uuid()) @db.Uuid
  fingerprint              String                @unique
  domain                   CisspDomain
  type                     QuestionType
  difficulty               QuestionDifficulty
  environment              DeploymentEnvironment @default(GENERAL)
  framework                String?
  threat                   String?
  industry                 String?
  scenario                 String                @db.Text
  options                  Json
  correctOptionId          String                @db.VarChar(8)
  engineerInstinct         String                @db.Text
  whyInstinctFeelsRight    String                @db.Text
  hiddenCisspKeyword       String
  whatIsc2IsTesting       String                @db.Text
  managerVsEngineer        String                @db.Text
  memorizationTip          String                @db.Text
  whyCorrectAnswerWins     String                @db.Text
  managerTakeaway          String                @db.Text
  futurePattern            String                @db.Text
  authorSource             String?
  blueprintVersion         String                @default("2024-04-15")
  contentVersion           Int                   @default(1)
  isPublished              Boolean               @default(false)
  reviewedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  attempts                 QuestionAttempt[]

  @@index([domain, difficulty, isPublished])
  @@index([type, environment, isPublished])
  @@index([framework, threat, industry])
}

// A reusable quiz definition. Null createdByUserId means system-created.
model Quiz {
  id               String            @id @default(uuid()) @db.Uuid
  title            String
  mode             QuizMode
  questionLimit    Int
  durationMinutes  Int?
  adaptive         Boolean           @default(true)
  domainFilter     CisspDomain?
  isPublic         Boolean           @default(false)
  createdByUserId  String?           @db.Uuid
  createdBy        User?             @relation("QuizAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempts         QuizAttempt[]
}

model QuizAttempt {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  quizId             String              @db.Uuid
  status             QuizAttemptStatus   @default(IN_PROGRESS)
  currentOrdinal     Int                 @default(0)
  answeredCount      Int                 @default(0)
  correctCount       Int                 @default(0)
  abilityEstimate    Float?
  abilityUncertainty Float?
  selectionState     Json?
  startedAt          DateTime            @default(now())
  expiresAt          DateTime?
  completedAt        DateTime?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz               Quiz                @relation(fields: [quizId], references: [id], onDelete: Restrict)
  questionAttempts   QuestionAttempt[]

  @@index([userId, status, startedAt])
  @@index([quizId, startedAt])
}

// Create at delivery time. Answer once in an atomic transaction.
model QuestionAttempt {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  quizAttemptId     String                @db.Uuid
  questionId        String                @db.Uuid
  ordinal           Int
  status            QuestionAttemptStatus @default(DELIVERED)
  selectedOptionId  String?               @db.VarChar(8)
  isCorrect         Boolean?
  responseTimeMs    Int?
  explanation       Json?
  deliveredAt       DateTime              @default(now())
  answeredAt        DateTime?
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizAttempt       QuizAttempt           @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  question          Question              @relation(fields: [questionId], references: [id], onDelete: Restrict)
  biasEvents        BiasEvent[]

  @@unique([quizAttemptId, ordinal])
  @@unique([quizAttemptId, questionId])
  @@index([userId, answeredAt])
  @@index([questionId, isCorrect])
}

// Immutable detection evidence for an observed mindset pattern.
model BiasEvent {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  questionAttemptId String          @db.Uuid
  pattern           BiasPattern
  severity          BiasSeverity
  strength          Float           // 0..100; higher means stronger observed bias.
  rationale         String          @db.Text
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionAttempt   QuestionAttempt @relation(fields: [questionAttemptId], references: [id], onDelete: Cascade)

  @@unique([questionAttemptId, pattern])
  @@index([userId, pattern, createdAt])
}

// Rolling aggregates; upsert in the same transaction as BiasEvent.
model BiasScore {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  pattern    BiasPattern
  score      Float        @default(0) // 0..100; higher = worse.
  count      Int          @default(0)
  severity   BiasSeverity @default(LOW)
  trend      Float        @default(0) // Positive = bias worsening, negative = improving.
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId, severity, score])
}

// All component metrics are normalized 0..100 before calculating readiness.
// readiness = .40 domainMastery + .25 managerialScore +
//             .15 biasResistanceScore + .10 difficultyScore + .10 consistencyScore
// biasResistanceScore = 100 - engineerBiasIndex (higher index = more bias).
model ReadinessSnapshot {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @db.Uuid
  readiness           Float
  domainMastery       Float
  managerialScore     Float
  executiveThinking   Float
  engineerBiasIndex   Float
  biasResistanceScore Float
  architectBiasScore  Float
  difficultyScore     Float
  consistencyScore    Float
  questionCount       Int
  domainScores        Json                  // Map<CisspDomain, {accuracy, mastery, attempts}>
  blueprintVersion    String                @default("2024-04-15")
  calculatedAt        DateTime              @default(now())
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations     StudyRecommendation[]

  @@index([userId, calculatedAt])
}

model StudyRecommendation {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @db.Uuid
  snapshotId     String?              @db.Uuid
  domain         CisspDomain?
  biasPattern    BiasPattern?
  title          String
  rationale      String               @db.Text
  exercise       String               @db.Text
  priority       Int                  @default(3) // 1 = most urgent.
  targetQuestions Int                 @default(25)
  status         RecommendationStatus @default(OPEN)
  createdAt      DateTime             @default(now())
  completedAt    DateTime?
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot       ReadinessSnapshot?   @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([userId, status, priority])
  @@index([userId, domain, biasPattern])
}
