{
  "name": "cyberforge-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:ingest": "node --import tsx prisma/ingest.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@vinext/cloudflare": "^1.4.0",
    "clsx": "2.1.1",
    "lucide-react": "0.555.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "3.4.0",
    "vinext": "^1.4.6",
    "zod": "^4.6.7",
    "@clerk/nextjs": "^7.10.2",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "openai": "6.9.1",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.1",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "prisma": "^6.19.3",
    "@types/pg": "^8.15.5"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "fflate": "^0.8.2",
    "picomatch": "^4.0.4"
  }
